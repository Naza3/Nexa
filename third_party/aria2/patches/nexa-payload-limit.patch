@@ -0,0 +1,37 @@
+// Nexa dedicated payload bound; GPL-2.0-or-later, upstream OpenSSL exception.
+#ifndef NEXA_PAYLOAD_LIMIT_H
+#define NEXA_PAYLOAD_LIMIT_H
+#include <cstdint>
+#include <cstdlib>
+#include "DownloadFailureException.h"
+#include "error_code.h"
+namespace aria2 { namespace nexa {
+constexpr uint64_t MAX_PAYLOAD_BYTES = UINT64_C(17179869184);
+inline uint64_t parsePayloadMaxBytes(const char* value)
+{
+  // Canonical decimal only. The parent supplies this in a fresh environment.
+  if (!value || *value < '1' || *value > '9')
+    throw DOWNLOAD_FAILURE_EXCEPTION2("Nexa policy: invalid payload byte limit", error_code::FILE_IO_ERROR);
+  uint64_t result = 0;
+  for (const char* p = value; *p; ++p) {
+    if (*p < '0' || *p > '9' || result > (MAX_PAYLOAD_BYTES - (*p - '0')) / 10)
+      throw DOWNLOAD_FAILURE_EXCEPTION2("Nexa policy: invalid payload byte limit", error_code::FILE_IO_ERROR);
+    result = result * 10 + (*p - '0');
+  }
+  if (result < 4)
+    throw DOWNLOAD_FAILURE_EXCEPTION2("Nexa policy: invalid payload byte limit", error_code::FILE_IO_ERROR);
+  return result;
+}
+inline uint64_t payloadMaxBytesFromEnvironment()
+{
+  return parsePayloadMaxBytes(std::getenv("NEXA_PAYLOAD_MAX_BYTES"));
+}
+inline void enforcePayloadRange(uint64_t limit, int64_t offset, uint64_t length)
+{
+  // Check by subtraction before addition, conversion to size_t or OS I/O.
+  if (offset < 0 || static_cast<uint64_t>(offset) > limit ||
+      length > limit - static_cast<uint64_t>(offset))
+    throw DOWNLOAD_FAILURE_EXCEPTION2("Nexa policy: payload byte limit exceeded", error_code::FILE_IO_ERROR);
+}
+}} // namespace aria2::nexa
+#endif
