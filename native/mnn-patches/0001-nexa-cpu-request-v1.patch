 void ArGeneration::generate(GenerationParams& param) {
+    if (mLlm->mNexaHooks.token) {
+        for (int accepted = 0; accepted < param.max_new_tokens; ++accepted) {
+            if (!mLlm->nexaCheckpointV1(5, mContext->output_tokens.size())) return;
+            mContext->current_token = mLlm->sample(param.outputs[0], param.validLogitStart, param.validLogitSize);
+            mContext->history_tokens.push_back(mContext->current_token);
+            mContext->output_tokens.push_back(mContext->current_token);
+            mLlm->updateContext(0, 1);
+            const bool terminal = mLlm->is_stop(mContext->current_token);
+            const int action = mLlm->mNexaHooks.token(mLlm->mNexaHooks.user, mContext->current_token, terminal);
+            if (action == 1) { mContext->status = LlmStatus::NORMAL_FINISHED; return; }
+            if (action == 2) { mContext->status = LlmStatus::USER_CANCEL; return; }
+            if (action != 0) { mContext->status = LlmStatus::INTERNAL_ERROR; return; }
+            if (!mLlm->nexaCheckpointV1(5, mContext->output_tokens.size())) return;
+            if (terminal) return;
+            if (accepted + 1 == param.max_new_tokens) {
+                mContext->status = LlmStatus::MAX_TOKENS_FINISHED; return;
+            }
+            MNN::Timer timer;
+            auto outputs = mLlm->forwardVec({mContext->current_token});
+            if (outputs.empty()) { mContext->status = LlmStatus::INTERNAL_ERROR; return; }
+            mLlm->updateContext(1, 0);
+            mContext->decode_us += timer.durationInUs();
+            if (!mLlm->nexaCheckpointV1(5, mContext->output_tokens.size())) return;
+        }
+        return;
+    }
