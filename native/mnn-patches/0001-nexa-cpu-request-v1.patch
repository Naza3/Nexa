+    auto config = std::make_shared<LlmConfig>();
+    config->config_ = ujson::json::parse("{}");
+    config->config_["sampler_type"] = temperature == 0 ? "greedy" : "topP";
+    config->config_["temperature"] = temperature;
+    config->config_["topP"] = top_p;
+    std::shared_ptr<Sampler> sampler(Sampler::createSampler(mContext, config));
+    if (!sampler) return false;
+    sampler->nexaSeedV1(seed);
+    mSampler = std::move(sampler);
+    return true;
